{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rawatin-ai",
  "main": "src/index.js",
  "compatibility_date": "2026-11-10",
  "observability": {
    "enabled": true
  },
  "vars": {
    "GEMINI_MODEL": "gemini-3.5-flash-lite",
    "RATE_LIMIT_MAX": "10",
    "RATE_LIMIT_WINDOW_SECONDS": "60"
  },
  // Namespace KV untuk rate limit per install_id.
  // Dibuat dengan: npx.cmd wrangler kv namespace create AI_RATE_LIMIT
  "kv_namespaces": [
    {
      "binding": "AI_RATE_LIMIT",
      "id": "9be11aa2498a4ef9b9a38ff304650597"
    }
  ]
}
